   "steps": [
    {
     "tool": "Bash",
     "command": "npm install",
     "stderr": "npm warn deprecated x@1"
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 0
   }
  },
  {
   "name": "is_error tool result without an exit code (state-changing Bash) fails",
   "steps": [
    {
     "tool": "Bash",
     "command": "./deploy.sh",
     "is_error": true
    }
   ],
   "expect": {
    "success": false,
    "failed_steps": 1
   }
  },
  {
   "name": "is_error tool result of an MCP tool is counted, not decisive",
   "steps": [
    {
     "tool": "mcp__linear__get_issue",
     "is_error": true
    },
    {
     "tool": "Edit",
     "file_path": "/p/a.py"
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 1
   }
  },
  {
   "name": "heredoc: only the first line names the family",
   "steps": [
    {
     "tool": "Bash",
     "command": "python3 - <<'EOF'\nimport sys\nrm -rf x\nEOF",
     "exit": 1,
     "is_error": true
    },
    {
     "tool": "Bash",
     "command": "python3 - <<'EOF'\nprint(1)\nEOF",
     "exit": 0
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 1
   }
  },
  {
   "name": "timeout and sudo wrappers are skipped",
   "steps": [
    {
     "tool": "Bash",
     "command": "timeout 60 rstest tests",
     "exit": 1,
     "is_error": true
    },
    {
     "tool": "Bash",
     "command": "sudo rstest tests",
     "exit": 0
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 1
   }
  },
  {
   "name": "absolute binary path uses the basename",
   "steps": [
    {
     "tool": "Bash",
     "command": "/usr/bin/grep -q x f",
     "exit": 1,
     "is_error": true
    },
    {
     "tool": "Edit",
     "file_path": "/p/a.py"
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 0
   }
  },
  {
   "name": "only read-only tools, one failed",
   "steps": [
    {
     "tool": "Glob",
     "is_error": true
    },
    {
     "tool": "Read",
     "file_path": "/p/a.py"
    }
   ],
   "expect": {
    "success": true,
    "failed_steps": 1
   }
  }
 ]
