{
  "description": "ace-cli init write target (spec/project-context.md section 9). Paths relative to layout root; expect.root is where .ace/config.json is written.",
  "cases": [
    {
      "name": "plain repo -> repo root",
      "layout": {
        "repo/.git/config": "[core]\n",
        "repo/src": null
      },
      "cwd": "repo/src",
      "expect": {
        "root": "repo",
        "mainCheckout": false
      }
    },
    {
      "name": "linked worktree -> main checkout root",
      "layout": {
        "main/.git/config": "[core]\n",
        "wt/.git": "gitdir: ../main/.git/worktrees/wt\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/gitdir": "../../../../wt/.git\n"
      },
      "cwd": "wt",
      "expect": {
        "root": "main",
        "mainCheckout": true
      }
    },
    {
      "name": "linked worktree with its own .ace/config.json (found by walk-up) shadows main -> warning",
      "layout": {
        "main/.git/config": "[core]\n",
        "wt/.git": "gitdir: ../main/.git/worktrees/wt\n",
        "main/.git/worktrees/wt/commondir": "../..\n",
        "wt/.ace/config.json": "{\"orgId\": \"o\", \"projectId\": \"p_old\"}",
        "wt/src": null,
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/wt/gitdir": "../../../../wt/.git\n"
      },
      "cwd": "wt/src",
      "expect": {
        "root": "main",
        "mainCheckout": true,
        "shadowedBy": "wt/.ace/config.json"
      }
    },
    {
      "name": "worktree nested in main -> main root",
      "layout": {
        "main/.git/config": "[core]\n",
        "main/.claude/worktrees/x/.git": "gitdir: ../../../.git/worktrees/x\n",
        "main/.git/worktrees/x/commondir": "../..\n",
        "main/.git/HEAD": "ref: refs/heads/main\n",
        "main/.git/worktrees/x/gitdir": "../../../.claude/worktrees/x/.git\n"
      },
      "cwd": "main/.claude/worktrees/x",
      "expect": {
        "root": "main",
        "mainCheckout": true
      }
    },
    {
      "name": "submodule (no commondir) -> submodule root",
      "layout": {
        "super/.git/config": "[core]\n",
        "super/.git/modules/sub/config": "[core]\n",
        "super/sub/.git": "gitdir: ../.git/modules/sub\n"
      },
      "cwd": "super/sub",
      "expect": {
        "root": "super/sub",
        "mainCheckout": false
      }
    },
    {
      "name": "outside git -> cwd",
      "layout": {
        "plain": null
      },
      "cwd": "plain",
      "expect": {
        "root": "plain",
        "mainCheckout": false
      }
    },
    {
      "name": "forged .git file: commondir points at an unrelated dir -> untrusted, falls back to worktree root",
      "layout": {
        "victim/HEAD": "ref: refs/heads/main\n",
        "victim/config": "[core]\n",
        "wt/.git": "gitdir: ../gd\n",
        "gd/commondir": "../victim\n"
      },
      "cwd": "wt",
      "expect": {
        "root": "wt",
        "mainCheckout": false,
        "untrusted": true
      }
    }
  ]
}
